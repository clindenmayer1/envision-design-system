{
  "$schema": "../theme.schema.json",
  "id": "envision",
  "name": "Envision Default",
  "version": "1.0.0",
  "kind": "default",
  "description": "The unbranded default. Deliberately neutral warm ink: it is what the system looks like before a builder theme loads, so nothing in the product or the documentation reads as 'the Envision color'.",
  "brand": {
    "primary": {
      "50": "#F5F4F2",
      "100": "#E8E6E2",
      "200": "#D2CFC9",
      "300": "#ABA7A0",
      "400": "#726E68",
      "500": "#3A3835",
      "600": "#2E2C2A",
      "700": "#242321",
      "800": "#1A1918",
      "900": "#101010"
    },
    "accent": {
      "50": "#EEEFEC",
      "100": "#E5E5E1",
      "200": "#D4D4CA",
      "300": "#C1C1B3",
      "400": "#ADAD9C",
      "500": "#999988",
      "600": "#7C7C6D",
      "700": "#6C6C5F",
      "800": "#3E3E35",
      "900": "#1C1C16"
    },
    "contentOnBrand": "#FFFFFF",
    "fontFamily": {
      "display": "Playfair Display",
      "wordmark": "Georgia"
    }
  }
}
